// SOLUTION k2 — two temporal facts joined by &&.

@id("allow_other_tools")
permit (principal, action in Drupe::Action::"CallTool", resource)
unless { action == Drupe::Action::"MergePullRequest" };

@id("merge_rule")
permit (principal, action == Drupe::Action::"MergePullRequest", resource)
when temporal {
    formerly within 24h Drupe::Action::"RequestApproval"::response{
        input.change: context.input.pr,
        input.kind: "review",
        output.approved: true
    }
    && (!Drupe::Action::"PushCommit"::request{ input.pr: context.input.pr }
        since within 24h
        Drupe::Action::"RunTests"::response{ input.pr: context.input.pr, output.passed: true })
};
